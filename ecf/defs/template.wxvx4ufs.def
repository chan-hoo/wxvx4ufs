suite {{ exp_case_name }}
    family cycle
        repeat date YMD {{ yyyymmdd_first }} {{ yyyymmdd_last }} {{ date_cycle_freq_day }}
{% if sched == "slurm" %}
        edit ECF_JOB_CMD "sbatch %ECF_JOB%"
{% elif sched == "pbspro" %}
        edit ECF_JOB_CMD "qsub %ECF_JOB%"
{% endif %}
        edit ECF_FILES "{{ exp_case_path }}/ecf/ecf_scripts"
        edit ECF_DATE %YMD%
        edit CYC {{ hh_first }}
{% if "prewxvx" in task_list %}
        task jwxvx_prewxvx
{% endif %}
{% if "vx_grid2grid" in task_list %}
        task jwxvx_vx_grid2grid
        {% if "prewxvx" in task_list %}
            trigger jwxvx_prewxvx == complete
  {% endif %}
{% endif %}
{% if "vx_grid2obs" in task_list %}
        task jwxvx_vx_grid2obs
        {% if "prewxvx" in task_list %}
            trigger jwxvx_prewxvx == complete
  {% endif %}
{% endif %}
{% if "postwxvx_grid" in task_list %}
        task jwxvx_postwxvx_grid
            trigger jwxvx_vx_grid2grid == complete
{% endif %}
{% if "postwxvx_obs" in task_list %}
        task jwxvx_postwxvx_obs
            trigger jwxvx_vx_grid2obs == complete
{% endif %}
    endfamily
endsuite

